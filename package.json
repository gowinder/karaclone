    "phase0:preflight": "node scripts/phase0/write-preflight.mjs"
  },
  "dependencies": {
    "@trpc/server": "11.9.0",
    "superjson": "2.2.1",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.3",
    "@cloudflare/workers-types": "5.20260902.1",
    "@trpc/client": "11.9.0",
    "@types/node": "26.4.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  }
}
